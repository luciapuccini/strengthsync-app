{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "stream",
  "globalDependencies": ["tsconfig.base.json", "pnpm-workspace.yaml"],
  "tasks": {
    "dev": {
      "cache": false,
      "persistent": true
    },
    "typecheck": {
      "dependsOn": ["^typecheck"],
      "outputs": ["dist/**", "*.tsbuildinfo"]
    },
    "lint": {
      "outputs": []
    },
    "test": {
      "dependsOn": ["^typecheck"],
      "outputs": []
    },
    "build": {
      "dependsOn": ["^typecheck", "^build"],
      "outputs": ["dist/**"]
    },
    "@strengthsync/client#build": {
      "dependsOn": ["^typecheck", "^build"],
      "outputs": ["dist/**"],
      "env": ["VITE_POSTHOG_KEY"]
    },
    "@strengthsync/server#build": {
      "dependsOn": ["^typecheck", "^build", "@strengthsync/client#build"],
      "outputs": []
    },
    "deploy": {
      "dependsOn": ["build"],
      "outputs": [],
      "cache": false,
      "passThroughEnv": ["CLOUDFLARE_API_TOKEN", "CLOUDFLARE_ACCOUNT_ID"]
    }
  }
}
