# Secrets for the local workflow runtime (docker-compose.workflows.yml).
# Copy to .env.workflows (git-ignored) and fill in. Never commit real values.
# Reference: docs/operations/local_worker.md — Secrets.

# Temporal Cloud (leave ADDRESS/NAMESPACE unset to target a local dev server
# when running outside Docker; containers normally use Cloud).
TEMPORAL_ADDRESS=quickstart-luciapuccini.wu1pr.tmprl.cloud:7233
TEMPORAL_NAMESPACE=quickstart-luciapuccini.wu1pr
TEMPORAL_API_KEY=""

# LLM providers (used by activities in milestones 4–5).
OPENAI_API_KEY=""
OPENAI_MODEL=gpt-4.1-mini
BRAINTRUST_API_KEY=''
BRAINTRUST_PROJECT=StrengthSync Workflows

# apps/api internal data-command surface the worker calls back into.
INTERNAL_API_BASE_URL=
INTERNAL_API_SERVICE_SECRET=

# Shared only with apps/api: authenticates requests through the tunnel.
WORKFLOW_SERVICE_SECRET=
WORKFLOW_API_PORT=3001

# Cloudflare Tunnel token (cloudflared container only).
TUNNEL_TOKEN=
