{
  "name": "@strengthsync/api-contract",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./openapi.d.ts"
  },
  "scripts": {
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "gen:openapi": "openapi-typescript openapi.json -o openapi.d.ts",
    "check:openapi": "openapi-typescript openapi.json -o /tmp/openapi.d.ts && diff -u openapi.d.ts /tmp/openapi.d.ts"
  },
  "devDependencies": {
    "openapi-typescript": "^7.13.0",
    "typescript": "6.0.2"
  }
}
