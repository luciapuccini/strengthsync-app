{
  "name": "@strengthsync/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "dev": "wrangler dev",
    "types": "wrangler types",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "test": "vitest run",
    "build": "wrangler deploy --dry-run",
    "deploy": "pnpm run db:migrate:remote && wrangler deploy",
    "db:generate": "drizzle-kit generate --config db/drizzle.config.ts",
    "db:migrate:local": "wrangler d1 migrations apply strengthsync --local",
    "db:seed:local": "wrangler d1 execute strengthsync --local --file ./db/seeds/000_default_coach.sql",
    "db:seed:demo:local": "wrangler d1 execute strengthsync --local --file ./db/seeds/001_demo_seed.sql",
    "db:seed:history:local": "wrangler d1 execute strengthsync --local --file ./db/seeds/002_historical_weeks.sql",
    "db:migrate:remote": "wrangler d1 migrations apply strengthsync --remote",
    "db:seed:remote": "wrangler d1 execute strengthsync --remote --file ./db/seeds/000_default_coach.sql",
    "db:seed:demo:remote": "wrangler d1 execute strengthsync --remote --file ./db/seeds/001_demo_seed.sql",
    "db:seed:history:remote": "wrangler d1 execute strengthsync --remote --file ./db/seeds/002_historical_weeks.sql"
  },
  "dependencies": {
    "@ai-sdk/openai": "catalog:",
    "@hono/zod-openapi": "catalog:",
    "ai": "catalog:",
    "drizzle-orm": "catalog:",
    "hono": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/better-sqlite3": "7.6.13",
    "@types/node": "catalog:",
    "better-sqlite3": "13.0.1",
    "drizzle-kit": "0.31.10",
    "wrangler": "4.112.0"
  }
}
