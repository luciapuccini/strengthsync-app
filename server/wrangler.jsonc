{
  "name": "strengthsync-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-21",
  // Without this, console.* from the Worker never reaches Workers Logs.
  "observability": {
    "enabled": true,
    "logs": {
      "invocation_logs": true
    }
  },
  "assets": {
    "directory": "../client/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
      "run_worker_first": ["/api/*", "/wf/*", "/health"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "strengthsync",
      // Placeholder for local dev. Before deploying, run
      // `wrangler d1 create strengthsync` and paste the real database_id,
      // then apply migrations + seed (see package.json scripts).
      "database_id": "3d9980fa-e3f2-4a19-9dac-1c63db6132a6",
      "migrations_dir": "./db/drizzle"
    }
  ],
  "workflows": [
		{
			"name": "strengthsync-workflow",
			"binding": "STRENGTHSYNC_WORKFLOW",
			"class_name": "StrengthsyncWorkflow"
		}
	]
}
