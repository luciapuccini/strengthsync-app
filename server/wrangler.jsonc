{
  "name": "strengthsync-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-21",
  "routes": [
    {
      "pattern": "app.strengthsync.ai",
      "custom_domain": true,
    },
  ],
  "observability": {
    "enabled": true,
    "logs": {
      "invocation_logs": true,
    },
  },
  "assets": {
    "directory": "../client/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/health", "/ingest/*"],
  },
  "vars": {
    "AUTH0_ISSUER": "https://auth.strengthsync.ai/",
    "AUTH0_JWKS_URI": "https://auth.strengthsync.ai/.well-known/jwks.json",
    "AUTH0_AUDIENCE": "https://api.strengthsync.ai",
    "AUTH0_ISSUER_DOMAIN": "auth.strengthsync.ai",
    "AUTH0_TENANT_DOMAIN": "dev-ky58kx02q7r2ukt6.us.auth0.com",
    "AUTH0_M2M_CLIENT_ID": "aURi7aSf2Z1YHTZkUzgQURPHIbo8Xmb0",
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "strengthsync",
      "database_id": "3d9980fa-e3f2-4a19-9dac-1c63db6132a6",
      "migrations_dir": "./db/drizzle",
    },
  ],
  "workflows": [
    {
      "name": "strengthsync-workflow",
      "binding": "STRENGTHSYNC_WORKFLOW",
      "class_name": "StrengthsyncWorkflow",
    },
  ],
}
