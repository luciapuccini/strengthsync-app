# PostHog project key (docs/mvp.md §5). Autocapture stays off in code either
# way; leaving this unset just means analytics.ts no-ops instead of sending
# events nowhere. Never commit the real value — copy this file to .env.local.
VITE_POSTHOG_KEY=phc_...

# Defaults to PostHog Cloud US. Only needed for a different region/host or a
# self-hosted instance.
# VITE_POSTHOG_HOST=https://us.i.posthog.com
