{
  "name": "@strengthsync/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "dev": "wrangler dev",
    "types": "wrangler types",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "test": "vitest run",
    "build": "wrangler deploy --dry-run",
    "deploy": "pnpm run db:migrate:remote && wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply strengthsync --local",
    "db:seed:local": "wrangler d1 execute strengthsync --local --file ../../services/db/seeds/000_default_coach.sql",
    "db:seed:demo:local": "wrangler d1 execute strengthsync --local --file ../../services/db/seeds/001_demo_seed.sql",
    "db:seed:history:local": "wrangler d1 execute strengthsync --local --file ../../services/db/seeds/002_historical_weeks.sql",
    "db:migrate:remote": "wrangler d1 migrations apply strengthsync --remote",
    "db:seed:remote": "wrangler d1 execute strengthsync --remote --file ../../services/db/seeds/000_default_coach.sql",
    "db:seed:demo:remote": "wrangler d1 execute strengthsync --remote --file ../../services/db/seeds/001_demo_seed.sql",
    "db:seed:history:remote": "wrangler d1 execute strengthsync --remote --file ../../services/db/seeds/002_historical_weeks.sql"
  },
  "dependencies": {
    "@strengthsync/db": "workspace:*",
    "@strengthsync/domain": "workspace:*",
    "drizzle-orm": "catalog:",
    "hono": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "wrangler": "4.112.0"
  }
}
