{
  "name": "@strengthsync/workflows",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev:api": "dotenv -e ../../.dev.vars -- tsx watch src/api/server.ts",
    "dev:worker": "dotenv -e ../../.dev.vars -- tsx watch src/worker.ts",
    "start:api": "tsx src/api/server.ts",
    "start:worker": "tsx src/worker.ts",
    "eval:score": "dotenv -e ../../.dev.vars -- tsx evals/cli.ts score",
    "eval:replay": "dotenv -e ../../.dev.vars -- tsx evals/cli.ts replay"
  },
  "dependencies": {
    "@ai-sdk/openai": "catalog:",
    "@hono/node-server": "^2.0.11",
    "@strengthsync/agent": "workspace:*",
    "@strengthsync/domain": "workspace:*",
    "@temporalio/client": "^1.20.3",
    "@temporalio/common": "^1.20.3",
    "@temporalio/worker": "^1.20.3",
    "@temporalio/workflow": "^1.20.3",
    "ai": "catalog:",
    "autoevals": "^0.3.0",
    "braintrust": "^3.24.0",
    "hono": "catalog:",
    "openai": "^6.48.0",
    "tsx": "^4.23.1",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "dotenv-cli": "11.0.0"
  }
}
