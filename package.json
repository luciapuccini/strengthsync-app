{
  "name": "strengthsync-app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@11.1.2",
  "engines": {
    "node": ">=22.14.0 <23.0.0"
  },
  "scripts": {
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "test": "vitest run",
    "eval:score": "pnpm --filter @strengthsync/workflows eval:score",
    "eval:replay": "pnpm --filter @strengthsync/workflows eval:replay",
    "prepare": "lefthook install || echo 'lefthook: skipped (not a git repository yet)'"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.6.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.3",
    "globals": "17.7.0",
    "lefthook": "2.1.10",
    "typescript": "6.0.2",
    "typescript-eslint": "8.62.0",
    "vitest": "4.1.10"
  }
}
