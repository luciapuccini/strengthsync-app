{
  "name": "strengthsync-app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@11.1.2",
  "engines": {
    "node": ">=22.14.0 <23.0.0"
  },
  "scripts": {
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "build": "turbo run build",
    "typecheck:affected": "turbo run typecheck --affected",
    "lint:affected": "turbo run lint --affected",
    "test:affected": "turbo run test --affected",
    "build:affected": "turbo run build --affected",
    "deploy:affected": "turbo run deploy --affected",
    "gen:openapi": "pnpm --filter @strengthsync/server gen:openapi && openapi-typescript server/openapi.json -o client/src/api/openapi.d.ts",
    "check:openapi": "node --experimental-strip-types server/scripts/gen-openapi.ts /tmp/strengthsync-openapi.json && diff -u server/openapi.json /tmp/strengthsync-openapi.json && openapi-typescript server/openapi.json -o /tmp/strengthsync-openapi.d.ts && diff -u client/src/api/openapi.d.ts /tmp/strengthsync-openapi.d.ts",
    "deps:check": "node scripts/check-dependency-policy.mjs",
    "ts:diagnostics": "node scripts/ts-metrics.mjs diagnostics",
    "ts:list-files": "node scripts/ts-metrics.mjs list-files",
    "ts:explain-files": "node scripts/ts-metrics.mjs explain-files",
    "ts:trace": "node scripts/ts-metrics.mjs trace",
    "prepare": "lefthook install || echo 'lefthook: skipped (not a git repository yet)'"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.6.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.3",
    "globals": "17.7.0",
    "lefthook": "2.1.10",
    "openapi-typescript": "^7.13.0",
    "turbo": "catalog:",
    "typescript": "6.0.2",
    "typescript-eslint": "8.62.0",
    "vitest": "4.1.10",
    "yaml": "2.9.0"
  }
}
