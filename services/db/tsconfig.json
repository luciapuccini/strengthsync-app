{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // "node" types are needed only by src/testing/ (better-sqlite3, fs).
    // The public surface (schema, repositories, index) stays runtime-neutral
    // and is what the API Worker bundles.
    "types": ["node"],
    "rootDir": "src",
    "outDir": "dist"
  },
  "include": ["src"],
  "references": [{ "path": "../domain" }]
}
